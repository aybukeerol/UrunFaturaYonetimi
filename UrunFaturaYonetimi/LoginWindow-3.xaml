<Window x:Class="UrunFaturaYonetimi.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXORA"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1150"
        MinHeight="700"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="53*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL PANEL -->
        <Grid x:Name="LeftPanel" Grid.Column="0" ClipToBounds="True">

            <!-- Dekoratif halkalar -->
            <Ellipse x:Name="DecorEllipse1"
                     Width="600" Height="600"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-350,0,0,-340"
                     StrokeThickness="34"
                     Opacity="0.18"/>

            <Ellipse x:Name="DecorEllipse2"
                     Width="520" Height="520"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-310,0,0,-305"
                     StrokeThickness="8"
                     Opacity="0.24"/>

            <Grid Margin="70,55,55,45">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LogoBox"
                            Width="58" Height="58"
                            CornerRadius="16"
                            HorizontalAlignment="Left">
                        <TextBlock Text="N"
                                   Foreground="White"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="BrandText"
                                   Text="NEXORA"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="BrandSubText"
                                   Text="İşletme Yönetim Platformu"
                                   Margin="1,4,0,0"
                                   FontSize="14"/>
                    </StackPanel>
                </Grid>

                <!-- HERO -->
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="Hero1"
                               Text="İşlerin dağılmasın."
                               FontSize="31"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="Hero2"
                               Text="İşletmen tek ekranda kalsın."
                               Margin="0,4,0,0"
                               FontSize="31"
                               FontWeight="Bold"/>
                </StackPanel>

                <TextBlock x:Name="DescriptionText"
                           Grid.Row="4"
                           Text="Cari hesaplarınızı, ürünlerinizi ve faturalarınızı&#10;tek merkezden düzenli ve hızlı şekilde yönetin."
                           FontSize="16"
                           LineHeight="25"/>

                <!-- FEATURE 1 -->
                <Border x:Name="Feature1"
                        Grid.Row="6"
                        Height="72"
                        CornerRadius="14"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="FeatureIcon1"
                                Width="45" Height="45"
                                CornerRadius="11">
                            <TextBlock x:Name="FeatureIconText1"
                                       Text="▦"
                                       FontSize="23"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FeatureTitle1"
                                       Text="Tek merkezden yönetim"
                                       FontWeight="SemiBold"
                                       FontSize="15"/>
                            <TextBlock x:Name="FeatureDesc1"
                                       Text="Cari, ürün ve fatura işlemleri bir arada."
                                       Margin="0,4,0,0"
                                       FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FEATURE 2 -->
                <Border x:Name="Feature2"
                        Grid.Row="8"
                        Height="72"
                        CornerRadius="14"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="FeatureIcon2"
                                Width="45" Height="45"
                                CornerRadius="11">
                            <TextBlock x:Name="FeatureIconText2"
                                       Text="✓"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FeatureTitle2"
                                       Text="Güvenli hesap erişimi"
                                       FontWeight="SemiBold"
                                       FontSize="15"/>
                            <TextBlock x:Name="FeatureDesc2"
                                       Text="Parolalar hash ve salt yapısıyla korunur."
                                       Margin="0,4,0,0"
                                       FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FEATURE 3 -->
                <Border x:Name="Feature3"
                        Grid.Row="10"
                        Height="72"
                        CornerRadius="14"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="FeatureIcon3"
                                Width="45" Height="45"
                                CornerRadius="11">
                            <TextBlock x:Name="FeatureIconText3"
                                       Text="⚡"
                                       FontSize="21"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FeatureTitle3"
                                       Text="Hızlı işlem akışı"
                                       FontWeight="SemiBold"
                                       FontSize="15"/>
                            <TextBlock x:Name="FeatureDesc3"
                                       Text="Sık kullanılan işlemlere daha az adımla ulaşın."
                                       Margin="0,4,0,0"
                                       FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FOOTER -->
                <StackPanel Grid.Row="12">
                    <Border x:Name="FooterSeparator" Height="1"/>
                    <TextBlock x:Name="FooterText"
                               Text="Güvenli   •   Hızlı   •   Kolay Yönetim"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- SAĞ PANEL -->
        <Grid x:Name="RightPanel" Grid.Column="1">

            <Border x:Name="LoginCard"
                    Width="650"
                    MaxWidth="650"
                    MinHeight="620"
                    Padding="45"
                    CornerRadius="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TEMA -->
                    <Button x:Name="ThemeButton"
                            Grid.Row="0"
                            Width="135"
                            Height="42"
                            HorizontalAlignment="Right"
                            Click="ThemeButton_Click"
                            Cursor="Hand"
                            BorderThickness="0"
                            FontWeight="SemiBold"/>

                    <!-- BAŞLIK -->
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="WelcomeTitle"
                                   Text="Tekrar hoş geldiniz"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="WelcomeSubTitle"
                                   Text="Hesabınıza güvenli şekilde giriş yapın."
                                   Margin="0,7,0,0"
                                   FontSize="15"/>
                    </StackPanel>

                    <!-- KULLANICI -->
                    <StackPanel Grid.Row="4">
                        <TextBlock x:Name="UserLabel"
                                   Text="E-posta / Kullanıcı adı"
                                   Margin="0,0,0,9"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <Border x:Name="UserBorder"
                                Height="52"
                                CornerRadius="11"
                                BorderThickness="1">
                            <Grid Margin="15,0,15,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="UserIcon"
                                           Text="@"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Grid Grid.Column="1">
                                    <TextBox x:Name="UserTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="15"
                                             VerticalContentAlignment="Center"
                                             TextChanged="UserTextBox_TextChanged"
                                             GotFocus="Input_GotFocus"
                                             LostFocus="Input_LostFocus"/>

                                    <TextBlock x:Name="UserPlaceholder"
                                               Text="E-posta veya kullanıcı adı"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               FontSize="15"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ŞİFRE -->
                    <StackPanel Grid.Row="6">
                        <TextBlock x:Name="PasswordLabel"
                                   Text="Şifre"
                                   Margin="0,0,0,9"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <Border x:Name="PasswordBorder"
                                Height="52"
                                CornerRadius="11"
                                BorderThickness="1">
                            <Grid Margin="15,0,9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="PasswordIcon"
                                           Text="●"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Grid Grid.Column="1">
                                    <PasswordBox x:Name="PasswordBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="15"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="PasswordBox_PasswordChanged"
                                                 GotFocus="PasswordBox_GotFocus"
                                                 LostFocus="PasswordBox_LostFocus"/>

                                    <TextBox x:Name="VisiblePasswordBox"
                                             Visibility="Collapsed"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="15"
                                             VerticalContentAlignment="Center"
                                             TextChanged="VisiblePasswordBox_TextChanged"
                                             GotFocus="PasswordBox_GotFocus"
                                             LostFocus="PasswordBox_LostFocus"/>

                                    <TextBlock x:Name="PasswordPlaceholder"
                                               Text="Şifrenizi girin"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               FontSize="15"/>
                                </Grid>

                                <Button x:Name="EyeButton"
                                        Grid.Column="2"
                                        Content="◉"
                                        Click="EyeButton_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="18"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- FORGOT -->
                    <Button x:Name="ForgotButton"
                            Grid.Row="8"
                            HorizontalAlignment="Right"
                            Content="Şifremi unuttum?"
                            Click="ForgotButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <!-- LOGIN -->
                    <Button x:Name="LoginButton"
                            Grid.Row="10"
                            Height="56"
                            Content="Giriş yap  →"
                            Click="LoginButton_Click"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3A9BFF" Offset="0"/>
                                <GradientStop Color="#2765F5" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <TextBlock x:Name="SecureText"
                               Grid.Row="12"
                               Text="●  Güvenli oturum"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <Border x:Name="RegisterSeparator"
                            Grid.Row="14"/>

                    <StackPanel Grid.Row="16"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="RegisterQuestion"
                                   Text="Henüz hesabınız yok mu?"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="RegisterButton"
                                Content="Kayıt olun"
                                Margin="12,0,0,0"
                                Click="RegisterButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
