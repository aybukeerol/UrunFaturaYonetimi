<Window x:Class="UrunFaturaYonetimi.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXORA - Güvenli Giriş"
        Width="1480"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#08152A"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <SolidColorBrush x:Key="TextPrimary" Color="#F6F8FC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A7B5CC"/>
        <SolidColorBrush x:Key="Accent" Color="#3397FF"/>
        <SolidColorBrush x:Key="AccentStrong" Color="#2469F6"/>
        <SolidColorBrush x:Key="Success" Color="#18C56F"/>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.93"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3397FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#65B3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="53*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL PANEL -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#071F3B" Offset="0"/>
                    <GradientStop Color="#06172E" Offset="0.55"/>
                    <GradientStop Color="#041225" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Sağ üst koyu katman -->
            <Path Stretch="Fill"
                  Opacity="0.78"
                  Data="M 0,0 L 1,0 L 0.72,1 L 0.50,1 Z"
                  HorizontalAlignment="Right"
                  Width="360">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#203A62" Offset="0"/>
                        <GradientStop Color="#0A1D36" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Alt sol dekoratif ışık kıvrımları -->
            <Ellipse Width="640"
                     Height="420"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-360,0,0,-255"
                     Stroke="#1B58C8"
                     StrokeThickness="48"
                     Opacity="0.62"/>
            <Ellipse Width="560"
                     Height="365"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-325,0,0,-225"
                     Stroke="#2978F4"
                     StrokeThickness="13"
                     Opacity="0.62"/>
            <Ellipse Width="495"
                     Height="320"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-288,0,0,-195"
                     Stroke="#4B90FF"
                     StrokeThickness="4"
                     Opacity="0.38"/>

            <Grid Margin="70,58,50,46">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Marka -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="58" Height="58" HorizontalAlignment="Left">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="-8"/>
                        </Grid.RenderTransform>

                        <Path Data="M8,19 C18,1 27,45 39,18 C49,0 58,6 55,29 C52,53 44,58 34,39 C25,20 17,53 8,42 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#58B9FF" Offset="0"/>
                                    <GradientStop Color="#2A55FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NEXORA"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="İşletme Yönetim Platformu"
                                   Margin="1,4,0,0"
                                   FontSize="15"
                                   Foreground="#93A8C7"/>
                    </StackPanel>
                </Grid>

                <!-- Hero -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="İşlerin dağılmasın."
                               FontSize="31"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="İşletmen tek ekranda kalsın."
                               Margin="0,3,0,0"
                               FontSize="31"
                               FontWeight="Bold"
                               Foreground="#68A7FF"/>
                </StackPanel>

                <TextBlock Grid.Row="4"
                           Text="Cari hesaplarınızı, ürünlerinizi ve faturalarınızı&#10;tek merkezden düzenli ve hızlı şekilde yönetin."
                           FontSize="16"
                           LineHeight="24"
                           Foreground="#B9C7DC"/>

                <!-- Feature 1 -->
                <Border Grid.Row="6"
                        CornerRadius="15"
                        BorderThickness="1.2"
                        BorderBrush="#6F6CA4E8"
                        Padding="10"
                        Height="69">
                    <Border.Effect>
                        <DropShadowEffect Color="#8C53D7FF"
                                          BlurRadius="14"
                                          ShadowDepth="0"
                                          Opacity="0.36"/>
                    </Border.Effect>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#24456C" Offset="0"/>
                            <GradientStop Color="#1B263F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48"
                                Height="48"
                                CornerRadius="11"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3B66A8" Offset="0"/>
                                    <GradientStop Color="#234B83" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="▥"
                                       FontSize="25"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tek merkezden yönetim"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Cari, ürün ve fatura işlemleri bir arada."
                                       Margin="0,3,0,0"
                                       FontSize="13"
                                       Foreground="#BCC9DC"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Feature 2 -->
                <Border Grid.Row="8"
                        CornerRadius="15"
                        BorderThickness="1.2"
                        BorderBrush="#6F6CA4E8"
                        Padding="10"
                        Height="69">
                    <Border.Effect>
                        <DropShadowEffect Color="#8C53D7FF"
                                          BlurRadius="14"
                                          ShadowDepth="0"
                                          Opacity="0.36"/>
                    </Border.Effect>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#24456C" Offset="0"/>
                            <GradientStop Color="#1B263F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48"
                                Height="48"
                                CornerRadius="11"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#2A568E">
                            <TextBlock Text="▣"
                                       FontSize="24"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Güvenli hesap erişimi"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Parolalar hash ve salt yapısıyla korunur."
                                       Margin="0,3,0,0"
                                       FontSize="13"
                                       Foreground="#BCC9DC"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Feature 3 -->
                <Border Grid.Row="10"
                        CornerRadius="15"
                        BorderThickness="1.2"
                        BorderBrush="#6F6CA4E8"
                        Padding="10"
                        Height="69">
                    <Border.Effect>
                        <DropShadowEffect Color="#8C53D7FF"
                                          BlurRadius="14"
                                          ShadowDepth="0"
                                          Opacity="0.36"/>
                    </Border.Effect>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#24456C" Offset="0"/>
                            <GradientStop Color="#1B263F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48"
                                Height="48"
                                CornerRadius="11"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#2A568E">
                            <TextBlock Text="ϟ"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Hızlı işlem akışı"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Sık kullanılan işlemlere daha az adımla ulaşın."
                                       Margin="0,3,0,0"
                                       FontSize="13"
                                       Foreground="#BCC9DC"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="12">
                    <Border Height="1" Background="#294663" Opacity="0.65"/>
                    <TextBlock Text="Güvenli   •   Hızlı   •   Kolay Yönetim"
                               HorizontalAlignment="Center"
                               Margin="0,21,0,0"
                               FontSize="13"
                               Foreground="#9FB2CC"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- SAĞ PANEL -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#172B4A" Offset="0"/>
                    <GradientStop Color="#0C1D36" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Border Width="690"
                    Height="690"
                    CornerRadius="27"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    BorderBrush="#304866">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="28"
                                      ShadowDepth="7"
                                      Opacity="0.26"/>
                </Border.Effect>

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1B2F4F" Offset="0"/>
                        <GradientStop Color="#142742" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="40,34,40,36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="53"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="ThemeButton"
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="132"
                            Height="42"
                            Content="☾  Koyu mod"
                            Click="ThemeButton_Click"
                            Style="{StaticResource FlatButtonStyle}"
                            Background="#2F3D55"
                            Foreground="White"/>

                    <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom">
                        <TextBlock Text="Tekrar hoş geldiniz"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Hesabınıza güvenli şekilde giriş yapın."
                                   Margin="0,5,0,0"
                                   FontSize="15"
                                   Foreground="#A7B6CC"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                        <TextBlock Text="E-posta / Kullanıcı adı"
                                   Margin="0,0,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <Border x:Name="UserBorder"
                                Height="49"
                                CornerRadius="10"
                                Background="#172945"
                                BorderBrush="#3A97FF"
                                BorderThickness="1.5">
                            <Grid Margin="14,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="♙"
                                           Foreground="#C2D0E4"
                                           FontSize="21"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="UserTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="UserTextBox_TextChanged"
                                             GotFocus="Input_GotFocus"
                                             LostFocus="Input_LostFocus"/>
                                    <TextBlock x:Name="UserPlaceholder"
                                               Text="E-posta veya kullanıcı adı"
                                               Foreground="#899CB9"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.RowSpan="2" VerticalAlignment="Bottom">
                        <TextBlock Text="Şifre"
                                   Margin="0,0,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <Border x:Name="PasswordBorder"
                                Height="49"
                                CornerRadius="10"
                                Background="#172945"
                                BorderBrush="#4A607D"
                                BorderThickness="1">
                            <Grid Margin="14,0,9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="▣"
                                           Foreground="#C2D0E4"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <PasswordBox x:Name="PasswordBox"
                                                 Background="Transparent"
                                                 Foreground="White"
                                                 BorderThickness="0"
                                                 FontSize="16"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="PasswordBox_PasswordChanged"
                                                 GotFocus="PasswordBox_GotFocus"
                                                 LostFocus="PasswordBox_LostFocus"/>
                                    <TextBox x:Name="VisiblePasswordBox"
                                             Visibility="Collapsed"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="VisiblePasswordBox_TextChanged"
                                             GotFocus="PasswordBox_GotFocus"
                                             LostFocus="PasswordBox_LostFocus"/>
                                    <TextBlock x:Name="PasswordPlaceholder"
                                               Text="Şifrenizi girin"
                                               Foreground="#899CB9"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="2"
                                        x:Name="EyeButton"
                                        Content="◉"
                                        Click="EyeButton_Click"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Foreground="#D7E1EF"
                                        FontSize="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="7"
                            x:Name="ForgotButton"
                            HorizontalAlignment="Right"
                            Content="Şifremi unuttum?"
                            Click="ForgotButton_Click"
                            Style="{StaticResource LinkButtonStyle}"
                            FontSize="14"/>

                    <Button Grid.Row="8"
                            x:Name="LoginButton"
                            Height="55"
                            Content="Giriş yap  →"
                            Click="LoginButton_Click"
                            Style="{StaticResource FlatButtonStyle}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3A9BFF" Offset="0"/>
                                <GradientStop Color="#2464F7" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <TextBlock Grid.Row="9"
                               Text="●  Güvenli oturum"
                               Foreground="#18C56F"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Border Grid.Row="10"
                            Background="#314967"
                            Opacity="0.62"/>

                    <StackPanel Grid.Row="11"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="Henüz hesabınız yok mu?"
                                   Foreground="#9FB0C7"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button Content="Kayıt olun"
                                Margin="15,0,0,0"
                                Click="RegisterButton_Click"
                                Style="{StaticResource LinkButtonStyle}"
                                FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
